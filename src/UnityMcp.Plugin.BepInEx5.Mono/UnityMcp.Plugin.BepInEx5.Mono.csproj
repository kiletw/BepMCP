<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>UnityMcp.Plugin.BepInEx5.Mono</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('$(UnityManagedPath)\UnityEngine.UI.dll')">
    <DefineConstants>$(DefineConstants);BEPMCP_UGUI</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('$(UnityManagedPath)\Unity.TextMeshPro.dll')">
    <DefineConstants>$(DefineConstants);BEPMCP_TMP</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnityMcp.Bridge\UnityMcp.Bridge.csproj" />
    <ProjectReference Include="..\UnityMcp.Core\UnityMcp.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(BepInExRoot)' != ''">
    <Reference Include="BepInEx">
      <HintPath>$(BepInExRoot)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(UnityManagedPath)' != ''">
    <Reference Include="UnityEngine">
      <HintPath>$(UnityManagedPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(UnityManagedPath)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule">
      <HintPath>$(UnityManagedPath)\UnityEngine.ScreenCaptureModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule" Condition="Exists('$(UnityManagedPath)\UnityEngine.UIModule.dll')">
      <HintPath>$(UnityManagedPath)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI" Condition="Exists('$(UnityManagedPath)\UnityEngine.UI.dll')">
      <HintPath>$(UnityManagedPath)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro" Condition="Exists('$(UnityManagedPath)\Unity.TextMeshPro.dll')">
      <HintPath>$(UnityManagedPath)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
